# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# Arc testnet token addresses (confirmed via docs.arc.io during planning)
USDC_ADDRESS=0x3600000000000000000000000000000000000000
EURC_ADDRESS=0x89B50855Aa3bE2F677cD6303Cec089B5F319D72a

# Any address you control. Simplest for a testnet deploy: same as your deployer.
TREASURY_ADDRESS=
ADMIN_ADDRESS=

# Optional — script defaults to 50 (0.50%) and 1e6 ($1-equivalent) if unset.
FEE_BPS=
MIN_AMOUNT=

# No private key here on purpose — supply it at deploy time only, via --interactive
# or a Foundry keystore. See README.md for the actual deploy command.
